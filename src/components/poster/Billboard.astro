---
/** Altruist outdoor: a hot British day, a T-shirt in the air and the bottle that should come out first. */
import AltruistBottle from './AltruistBottle.astro';
import { sentences } from './text';

interface Props {
  headline: string;
  sub?: string;
}

const { headline, sub } = Astro.props;
---

<div class="board">
  <span class="board__sun" aria-hidden="true" />

  <svg class="board__shirt" viewBox="0 0 120 110" aria-hidden="true">
    <path d="M38 6c6 8 14 12 22 12s16-4 22-12l34 18-12 28-14-6v60H30V46l-14 6L4 24z" fill="#fff" />
    <path d="M30 62h60M30 78h60M30 94h60" stroke="#2f6fd6" stroke-width="7" />
  </svg>

  <div class="board__copy">
    <p class="board__head">{sentences(headline).map((line) => <span>{line}</span>)}</p>
    {sub && <p class="board__sub">{sub}</p>}
    <p class="board__mark"><b>ALTRUIST</b> Made by a skin cancer surgeon.</p>
  </div>

  <div class="board__product">
    <AltruistBottle class="board__bottle" />
    <span class="board__price">£5.75<small>at Tesco</small></span>
  </div>
</div>

<style>
  .board {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    background: linear-gradient(160deg, #ffd24a 0%, #ffb000 45%, #ff7a00 100%);
    color: #141414;
    overflow: hidden;
  }

  .board__sun {
    position: absolute;
    right: -18cqmin;
    top: -22cqmin;
    width: 80cqmin;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fff6cf 0 42%, rgb(255 246 207 / 0.35) 43% 60%, transparent 61%);
  }

  .board__shirt {
    position: absolute;
    right: 14cqmin;
    top: 8cqmin;
    width: 26cqmin;
    transform: rotate(24deg);
    filter: drop-shadow(0 2cqmin 2cqmin rgb(120 50 0 / 0.25));
  }

  .board__copy {
    position: relative;
    display: grid;
    align-content: start;
    gap: 3cqmin;
    padding: 7cqmin;
  }

  .board__head {
    font-size: 14cqmin;
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .board__head span {
    display: block;
  }

  .board__head span + span {
    color: #fff;
    text-shadow: 0.7cqmin 0.7cqmin 0 #141414;
  }

  .board__sub {
    justify-self: start;
    padding: 0.5em 0.9em;
    border-radius: 99px;
    background: #141414;
    color: #ffd24a;
    font-size: 3.6cqmin;
    font-weight: 600;
  }

  .board__mark {
    font-size: 3.4cqmin;
    font-weight: 500;
  }

  .board__mark b {
    margin-right: 0.6em;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .board__product {
    position: relative;
    justify-self: end;
    height: 46cqmin;
    margin: 0 10cqmin 6cqmin 0;
  }

  .board__product :global(.board__bottle) {
    height: 100%;
    transform: rotate(8deg);
    filter: drop-shadow(-2cqmin 3cqmin 3cqmin rgb(120 50 0 / 0.35));
  }

  .board__price {
    position: absolute;
    left: -12cqmin;
    bottom: 4cqmin;
    display: grid;
    place-content: center;
    width: 17cqmin;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #1f2a44;
    color: #fff;
    font-size: 4.6cqmin;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    transform: rotate(-12deg);
  }

  .board__price small {
    font-size: 2.2cqmin;
    font-weight: 500;
    margin-top: 0.6cqmin;
  }

  @container (aspect-ratio > 1.3) {
    .board {
      grid-template-rows: none;
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .board__copy {
      align-content: center;
      padding-right: 0;
    }

    .board__head {
      font-size: 17cqmin;
    }

    .board__product {
      height: 78cqmin;
      margin: 0 8cqmin 0 14cqmin;
      align-self: center;
    }

    .board__shirt {
      right: 34%;
      top: 6cqmin;
    }

    .board__sun {
      right: -6cqmin;
      top: -30cqmin;
      width: 110cqmin;
    }
  }

  @container (aspect-ratio > 2.4) {
    .board__head {
      font-size: 24cqmin;
    }

    .board__sub {
      font-size: 4.6cqmin;
    }

    .board__mark {
      font-size: 4.2cqmin;
    }

    .board__price {
      width: 22cqmin;
      font-size: 6cqmin;
    }

    .board__price small {
      font-size: 2.8cqmin;
    }

    .board__shirt {
      right: 30%;
      width: 34cqmin;
    }
  }
</style>
