---
/**
 * Campaign key visual. Shows finished artwork when `image` is set; otherwise draws
 * the requested composition (`art`) in the campaign's art direction.
 * Every composition scales with the frame via container query units.
 */
import type { Art, PosterVariant, Ratio } from '../data/types';
import Grove from './poster/Grove.astro';
import Plaque from './poster/Plaque.astro';
import Passport from './poster/Passport.astro';
import Tooth from './poster/Tooth.astro';
import Plate from './poster/Plate.astro';
import Pack from './poster/Pack.astro';
import Billboard from './poster/Billboard.astro';
import Prescription from './poster/Prescription.astro';
import Shelf from './poster/Shelf.astro';

interface Props {
  variant: PosterVariant;
  art?: Art;
  ratio?: Ratio;
  headline: string;
  sub?: string;
  photo?: string;
  image?: string;
  alt?: string;
  class?: string;
}

const COMPOSITIONS = {
  grove: Grove,
  plaque: Plaque,
  passport: Passport,
  tooth: Tooth,
  plate: Plate,
  pack: Pack,
  bottle: Billboard,
  rx: Prescription,
  shelf: Shelf,
} satisfies Record<Art, unknown>;

/** The key visual used for covers and cards. */
const KEY_ART: Record<PosterVariant, Art> = {
  olivara: 'grove',
  humble: 'tooth',
  altruist: 'bottle',
};

const { variant, art = KEY_ART[variant], ratio = '4/5', headline, sub, photo, image, alt = headline, class: className = '' } = Astro.props;
const Composition = COMPOSITIONS[art];
---

<figure class:list={['poster', `poster--${variant}`, className]} style={`--ratio: ${ratio}`} data-art={art}>
  {
    image ? (
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <div class="poster__art" role="img" aria-label={[headline, sub].filter(Boolean).join(' ')}>
        <Composition headline={headline} sub={sub} photo={photo} />
      </div>
    )
  }
</figure>

<style>
  .poster {
    position: relative;
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    container-type: size;
  }

  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster__art {
    position: absolute;
    inset: 0;
  }
</style>
