---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="marquee dark" data-marquee aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {items.map((item) => (
            <span class="marquee__item">
              {item}
              <span class="marquee__star">✺</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(18px, 2.4vw, 32px);
    border-block: 1px solid var(--line);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group {
    display: flex;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding-right: 0.6em;
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .marquee__item:nth-child(even) {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .marquee__star {
    color: var(--accent);
    font-size: 0.6em;
  }
</style>
