---
import Pulse from '../Pulse.astro';
import { site } from '../../data/site';

const facts = [
  { label: 'Focus', value: 'Health & behaviour change' },
  { label: 'Model', value: 'COM-B / EAST' },
  { label: 'Next', value: 'Healthcare management' },
];
---

<section class="hero">
  <div class="wrap hero__inner">
    <p class="mono hero__kicker" data-reveal>
      <span>{site.hero.kicker}</span>
      <span>{site.role}</span>
    </p>

    <h1 class="hero__title" aria-label={site.hero.lines.join(' ')}>
      {
        site.hero.lines.map((line, i) => (
          <span class:list={['hero__line', { 'serif accent': i === 1 }]} aria-hidden="true">
            <span data-hero-line>{line}</span>
          </span>
        ))
      }
    </h1>

    <div class="hero__badge" data-speed="0.3" aria-hidden="true">
      <svg viewBox="0 0 200 200" class="hero__badge-ring">
        <defs><path id="badge-circle" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0"></path></defs>
        <text><textPath href="#badge-circle">Open to opportunities ✺ Health × Advertising ✺ </textPath></text>
      </svg>
      <span class="hero__badge-cross"></span>
    </div>

    <div class="hero__pulse" data-speed="-0.15">
      <Pulse mode="loop" />
    </div>

    <div class="hero__foot">
      <p class="lede" data-reveal>{site.hero.intro}</p>

      <dl class="hero__facts" data-reveal>
        {
          facts.map((f) => (
            <div>
              <dt class="mono muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <a href="#work" class="hero__scroll mono" data-reveal data-magnetic>
      <span>Scroll</span>
      <span class="hero__scroll-line"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    padding-top: 96px;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .hero__kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }

  .hero__title {
    margin-top: clamp(32px, 6vh, 80px);
    font-size: min(max(var(--step-5), 18vw), 19svh);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .hero__badge {
    position: absolute;
    right: calc(var(--gutter) + clamp(0px, 4vw, 72px));
    top: clamp(140px, 22vh, 240px);
    width: clamp(120px, 14vw, 210px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .hero__badge-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    animation: spin 18s linear infinite;
  }

  .hero__badge-ring text {
    font-family: var(--font-mono);
    font-size: 14.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: currentColor;
  }

  .hero__badge-cross {
    position: relative;
    width: 30%;
    aspect-ratio: 1;
    background: var(--accent);
    clip-path: polygon(35% 0, 65% 0, 65% 35%, 100% 35%, 100% 65%, 65% 65%, 65% 100%, 35% 100%, 35% 65%, 0 65%, 0 35%, 35% 35%);
    animation: beat 1.6s var(--ease-out) infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes beat {
    0%, 40%, 100% { transform: scale(1); }
    15% { transform: scale(1.25); }
    25% { transform: scale(0.92); }
  }

  @media (max-width: 700px) {
    .hero__badge {
      display: none;
    }
  }

  .hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
  }

  .hero__line > span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__line > span {
      transform: translateY(110%);
    }
  }

  .hero__line.serif {
    font-weight: 400;
    letter-spacing: -0.035em;
    padding-left: 0.6em;
  }

  .hero__pulse {
    color: var(--accent);
    margin-block: clamp(20px, 4vh, 48px);
    margin-inline: calc(var(--gutter) * -1);
  }

  .hero__foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    padding-bottom: clamp(32px, 6vh, 64px);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 12px 40px;
  }

  .hero__facts dd {
    margin-top: 4px;
    font-weight: 500;
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    writing-mode: vertical-rl;
  }

  .hero__scroll-line {
    width: 1px;
    height: 64px;
    background: currentColor;
    transform-origin: top;
    animation: scrollcue 2s var(--ease-in-out) infinite;
  }

  @keyframes scrollcue {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (min-width: 1100px) {
    .hero__scroll {
      display: flex;
    }
  }

  @media (max-width: 900px) {
    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
